{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taksi-ucreti-hesaplama",
  "compatibility_date": "2026-07-16",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
