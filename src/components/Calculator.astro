---
import { cities, publishedCities } from '../data/cities';
interface Props { fixedCity?: string }
const { fixedCity } = Astro.props;
const available = fixedCity ? publishedCities.filter((city) => city.slug === fixedCity) : cities;
const data = Object.fromEntries(available.map((city) => [city.slug, city]));
const calculatorId = `calc-${fixedCity ?? 'all'}`;
const hasNightTariff = available.some((city) => city.nightTariff.enabled && city.nightTariff.sourceUrl);
const hasWaitingTariff = available.some((city) => city.status === 'published' && city.categories.some((category) => category.waitingPerHour));
---
<section class="calculator" data-calculator data-cities={JSON.stringify(data)} aria-labelledby={calculatorId}>
  <header class="calc-heading">
    <h2 id={calculatorId}>{fixedCity ? `${available[0]?.name} taksi ücreti hesaplama` : 'Taksi ücreti hesaplama'}</h2>
    <p>81 ilden birini arayın. Tarife doğrulanmışsa mesafenizi hesaplayın; doğrulanmamış şehirlerde tahmin üretilmez.</p>
  </header>

  <form novalidate>
    <div class="calc-fields">
      <label class="field city-field">
        <span>Şehir seçin</span>
        <input name="city" list={`${calculatorId}-cities`} value={fixedCity ? available[0]?.name : ''} placeholder="Şehir adı yazın" autocomplete="off" required readonly={Boolean(fixedCity)} aria-describedby={`${calculatorId}-city-help`} />
        <datalist id={`${calculatorId}-cities`}>{available.map((city) => <option value={city.name}>{city.status === 'published' ? 'Tarife mevcut' : 'Doğrulama bekliyor'}</option>)}</datalist>
        <small id={`${calculatorId}-city-help`}>Türkçe karakterlerle arayabilir, ok tuşlarıyla seçim yapabilirsiniz.</small>
      </label>

      <label class="field distance-field">
        <span>Mesafe (km)</span>
        <input name="km" type="text" inputmode="decimal" placeholder="Örn. 20 veya 20,5" required />
      </label>

      <fieldset class="quick-distance">
        <legend>Hızlı mesafe seçimi</legend>
        <div>{[3, 5, 10, 15, 20, 30].map((km) => <button type="button" data-km={km} aria-pressed="false">{km} km</button>)}</div>
      </fieldset>

      <div class="calc-options">
        {hasNightTariff && <label class="switch-row" data-night-row>
          <input name="night" type="checkbox" />
          <span class="switch" aria-hidden="true"></span>
          <span><strong>Gece tarifesi</strong><small>Seçilen şehrin doğrulanmış gece tarifesini uygular.</small></span>
        </label>}
        <label class="switch-row">
          <input name="traffic" type="checkbox" aria-controls={`${calculatorId}-waiting`} aria-expanded="false" />
          <span class="switch" aria-hidden="true"></span>
          <span><strong>Bekleme ve ek ücretler</strong><small>Trafik süresini veya ücretli geçişleri ekleyin.</small></span>
        </label>
      </div>

      <div class="optional-fields" id={`${calculatorId}-waiting`} hidden>
        {hasWaitingTariff && <label class="field" data-waiting-field>
          <span>Bekleme süresi (dakika)</span>
          <input name="minutes" type="number" min="0" max="600" step="1" inputmode="numeric" value="0" />
        </label>}
        <label class="field">
          <span>Köprü, tünel veya ek ücret (TL)</span>
          <input name="extra" type="text" inputmode="decimal" value="0" />
        </label>
      </div>
    </div>

    <p class="form-error" role="alert"></p>
    <button class="calculate-button" type="submit">Ücreti hesapla</button>
    <p class="calc-disclaimer">Tahmini sonuçtur. Gerçek tutar taksimetre, güzergâh, trafik ve ücretli geçişlere göre değişebilir.</p>
  </form>

  <section class="result" aria-live="polite" aria-atomic="true" aria-label="Hesaplama sonucu">
    <div class="result-empty">
      <p class="result-title">Tahmini ücret</p>
      <strong>₺0</strong>
      <p>Hesaplama yapmak için şehir seçin ve mesafeyi girin.</p>
    </div>
  </section>
</section>

<script is:inline>
  document.querySelectorAll('[data-calculator]').forEach((root) => {
    const cityData = JSON.parse(root.dataset.cities);
    const form = root.querySelector('form');
    const citySelect = form.elements.city;
    const kmInput = form.elements.km;
    const trafficInput = form.elements.traffic;
    const optionalFields = root.querySelector('.optional-fields');
    const waitingField = root.querySelector('[data-waiting-field]');
    const nightRow = root.querySelector('[data-night-row]');
    const result = root.querySelector('.result');
    const error = root.querySelector('.form-error');
    const currency = new Intl.NumberFormat('tr-TR', { style: 'currency', currency: 'TRY' });
    const decimal = new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 2 });
    const normalize = (value) => String(value).trim().toLocaleLowerCase('tr');
    const selectedCity = () => Object.values(cityData).find((city) => normalize(city.name) === normalize(citySelect.value) || city.slug === citySelect.value) ?? (citySelect.readOnly ? Object.values(cityData)[0] : undefined);
    const safeNumber = (value) => Number(String(value).replace(',', '.'));
    const escapeHtml = (value) => String(value).replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[char]);
    const updateCityOptions = () => {
      const city = selectedCity();
      const hasWaiting = Boolean(city?.status === 'published' && city.categories?.some((category) => category.waitingPerHour));
      if (waitingField) waitingField.hidden = !hasWaiting;
      const nightAvailable = Boolean(city?.nightTariff?.enabled && city?.nightTariff?.sourceUrl);
      if (nightRow) nightRow.hidden = !nightAvailable;
      if (!nightAvailable && form.elements.night) form.elements.night.checked = false;
    };
    citySelect.addEventListener('change', updateCityOptions);
    citySelect.addEventListener('input', updateCityOptions);
    if (!citySelect.readOnly) try {
      const savedCity = localStorage.getItem('taksi-son-sehir');
      if (savedCity && Object.values(cityData).some((city) => city.name === savedCity)) citySelect.value = savedCity;
    } catch {}
    updateCityOptions();

    root.querySelectorAll('[data-km]').forEach((button) => {
      button.addEventListener('click', () => {
        kmInput.value = button.dataset.km;
        root.querySelectorAll('[data-km]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        kmInput.focus();
      });
    });

    kmInput.addEventListener('input', () => {
      root.querySelectorAll('[data-km]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.km === kmInput.value)));
    });

    trafficInput.addEventListener('change', () => {
      optionalFields.hidden = !trafficInput.checked;
      trafficInput.setAttribute('aria-expanded', String(trafficInput.checked));
      if (trafficInput.checked) (waitingField && !waitingField.hidden ? form.elements.minutes : form.elements.extra).focus();
      else { if (form.elements.minutes) form.elements.minutes.value = '0'; form.elements.extra.value = '0'; }
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const city = selectedCity();
      const km = safeNumber(kmInput.value);
      const minutes = trafficInput.checked && form.elements.minutes ? safeNumber(form.elements.minutes.value || 0) : 0;
      const extra = trafficInput.checked ? safeNumber(form.elements.extra.value || 0) : 0;

      if (!city) { error.textContent = 'Lütfen bir şehir seçin.'; citySelect.focus(); return; }
      if (city.status !== 'published') {
        error.textContent = '';
        result.innerHTML = `<div class="result-empty pending-result"><p class="result-title">${escapeHtml(city.name)}</p><strong>Tarife doğrulanıyor</strong><p>Bu şehir için güncel ve güvenilir tarife henüz doğrulanmadı. Yanlış bir ücret göstermemek için hesaplama kapalıdır.</p><a href="/iletisim/">Resmî tarife kaynağı bildirin</a></div>`;
        return;
      }
      if (!Number.isFinite(km) || km <= 0 || km > 500) { error.textContent = 'Mesafeyi 0,1 ile 500 km arasında girin.'; kmInput.focus(); return; }
      if (!Number.isFinite(minutes) || minutes < 0 || minutes > 600 || !Number.isFinite(extra) || extra < 0 || extra > 100000) {
        error.textContent = 'Bekleme süresi veya ek ücret geçerli aralıkta değil.'; return;
      }
      error.textContent = '';
      if (!citySelect.readOnly) try { localStorage.setItem('taksi-son-sehir', city.name); } catch {}

      const nightEnabled = Boolean(form.elements.night?.checked && city.nightTariff.enabled && city.nightTariff.sourceUrl);
      const calculations = city.categories.map((category) => {
        const distanceCharge = km * category.perKm;
        const waitingCharge = (category.waitingPerHour || 0) * minutes / 60;
        const standardBase = category.opening + distanceCharge + waitingCharge;
        const nightCharge = nightEnabled ? standardBase * (city.nightTariff.multiplier - 1) : 0;
        const base = standardBase + nightCharge;
        const minimumAdjustment = Math.max(0, category.minimum - base);
        const subtotal = base + minimumAdjustment;
        return { category, distanceCharge, waitingCharge, nightCharge, minimumAdjustment, subtotal, total: subtotal + extra };
      });
      const lowest = Math.min(...calculations.map((item) => item.total));
      const sourceLabel = city.sourceTier === 'official' ? 'Resmî kaynak' : 'İkincil kaynak';
      const nightNote = nightEnabled ? `<p class="result-note">Doğrulanmış gece tarifesi (${decimal.format(city.nightTariff.multiplier)}×) uygulandı.</p>` : '';

      result.innerHTML = `
        <header class="result-summary">
          <p class="result-title">${calculations.length > 1 ? 'En düşük kategori tahmini' : 'Tahmini ücret'}</p>
          <strong>${currency.format(lowest)}</strong>
          <p>${escapeHtml(city.name)} için ${decimal.format(km)} km${minutes ? ` ve ${decimal.format(minutes)} dakika bekleme` : ''} hesabı</p>
          ${nightNote}
        </header>
        <div class="fare-results">
          ${calculations.map(({ category, distanceCharge, waitingCharge, nightCharge, minimumAdjustment, subtotal, total }, index) => `
            <article class="fare-result fare-result-${index}">
              <header><div><h3>${escapeHtml(category.name)}</h3><small>${index === 0 ? 'Standart tarife' : 'Kategori tarifesi'}</small></div><strong>${currency.format(total)}</strong></header>
              <dl>
                <div><dt>Açılış ücreti</dt><dd>${currency.format(category.opening)}</dd></div>
                <div><dt>Kilometre tarifesi</dt><dd>${currency.format(category.perKm)} / km</dd></div>
                <div><dt>${decimal.format(km)} km mesafe ücreti</dt><dd>${currency.format(distanceCharge)}</dd></div>
                <div><dt>Minimum ücret sınırı</dt><dd>${currency.format(category.minimum)}</dd></div>
                ${minimumAdjustment > 0 ? `<div><dt>Minimum ücret düzeltmesi</dt><dd>+${currency.format(minimumAdjustment)}</dd></div>` : ''}
                ${minutes > 0 ? `<div><dt>Bekleme ücreti</dt><dd>${category.waitingPerHour ? currency.format(waitingCharge) : 'Tarife yayımlanmadı'}</dd></div>` : ''}
                ${nightCharge > 0 ? `<div><dt>Gece tarifesi farkı</dt><dd>${currency.format(nightCharge)}</dd></div>` : ''}
                <div><dt>Ara toplam</dt><dd>${currency.format(subtotal)}</dd></div>
                ${extra > 0 ? `<div><dt>Ek geçiş ücretleri</dt><dd>${currency.format(extra)}</dd></div>` : ''}
                <div class="total-row"><dt>Tahmini toplam</dt><dd>${currency.format(total)}</dd></div>
              </dl>
            </article>
          `).join('')}
        </div>
        <footer class="result-footer">
          <p>Tarife başlangıcı: <time datetime="${city.effectiveDate}">${city.effectiveDate.split('-').reverse().join('.')}</time> · Son kontrol: ${city.verifiedDate.split('-').reverse().join('.')}</p>
          <p>Kaynak durumu: ${sourceLabel} · ${escapeHtml(city.sourceName)}</p>
          <a href="${city.path}">${escapeHtml(city.name)} taksi tarifesinin ayrıntıları</a>
        </footer>`;
      result.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'nearest' });
    });
  });
</script>
