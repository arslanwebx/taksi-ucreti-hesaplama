---
import { cities } from '../data/cities';
interface Props { fixedCity?: string }
const { fixedCity } = Astro.props;
const available = fixedCity ? cities.filter((city) => city.slug === fixedCity) : cities;
const data = Object.fromEntries(available.map((city) => [city.slug, city]));
---
<section class="calculator" data-calculator data-cities={JSON.stringify(data)} aria-labelledby={`calc-${fixedCity ?? 'all'}`}>
  <div class="section-heading"><p class="eyebrow">Tarife tabanlı tahmin</p><h2 id={`calc-${fixedCity ?? 'all'}`}>{fixedCity ? `${available[0]?.name} taksi hesaplama` : 'Taksi fiyat hesaplama'}</h2></div>
  <form novalidate>
    <div class="form-grid">
      <label>Şehir<select name="city" required disabled={Boolean(fixedCity)}>{!fixedCity && <option value="">Şehir seçin</option>}{available.map((city) => <option value={city.slug}>{city.name}</option>)}</select></label>
      <label>Mesafe (km)<input name="km" type="number" min="0.1" max="500" step="0.1" inputmode="decimal" value="5" required /></label>
      <label>Bekleme (dakika)<input name="minutes" type="number" min="0" max="600" step="1" inputmode="numeric" value="0" /></label>
      <label>Taksi kategorisi<select name="category"></select></label>
      <label>Ek geçiş / yol ücreti (TL)<input name="extra" type="number" min="0" max="100000" step="0.01" inputmode="decimal" value="0" /></label>
    </div>
    <p class="form-error" role="alert"></p><button type="submit">Ücreti hesapla</button>
  </form>
  <div class="result" aria-live="polite" aria-atomic="true">
    <p class="result-label">Tahmini toplam</p><strong>—</strong><dl><div><dt>Açılış + mesafe</dt><dd>—</dd></div><div><dt>Bekleme</dt><dd>—</dd></div><div><dt>Minimum ücret farkı</dt><dd>—</dd></div><div><dt>Ek ücretler</dt><dd>—</dd></div></dl><p class="result-meta">Değerleri girip hesaplayın.</p>
  </div>
</section>
<script is:inline>
  document.querySelectorAll('[data-calculator]').forEach((root) => {
    const cities = JSON.parse(root.dataset.cities); const form = root.querySelector('form');
    const citySelect = form.elements.city; const categorySelect = form.elements.category; const result = root.querySelector('.result'); const error = root.querySelector('.form-error');
    const currency = new Intl.NumberFormat('tr-TR', { style:'currency', currency:'TRY' });
    const city = () => cities[citySelect.value || Object.keys(cities)[0]];
    const categories = () => { const c=city(); categorySelect.innerHTML = c ? c.categories.map(x => `<option value="${x.id}">${x.name}</option>`).join('') : ''; categorySelect.closest('label').hidden = !c || c.categories.length < 2; };
    citySelect.addEventListener('change', categories); categories();
    form.addEventListener('submit', (event) => {
      event.preventDefault(); const c=city(); const km=Number(form.elements.km.value); const minutes=Number(form.elements.minutes.value || 0); const extra=Number(form.elements.extra.value || 0);
      if (!c || !Number.isFinite(km) || km <= 0 || km > 500 || minutes < 0 || minutes > 600 || extra < 0 || extra > 100000) { error.textContent='Şehir seçin; mesafeyi 0–500 km, beklemeyi 0–600 dakika aralığında girin.'; return; }
      error.textContent=''; const cat=c.categories.find(x=>x.id===categorySelect.value) || c.categories[0]; const distance=cat.opening + km*cat.perKm; const waiting=(cat.waitingPerHour || 0)*minutes/60; const adjustment=Math.max(0,cat.minimum-distance-waiting); const total=distance+waiting+adjustment+extra;
      result.querySelector('strong').textContent=currency.format(total); const dd=result.querySelectorAll('dd'); [distance,waiting,adjustment,extra].forEach((x,i)=>dd[i].textContent=currency.format(x));
      result.querySelector('.result-meta').innerHTML=`Tarife başlangıcı: <time datetime="${c.effectiveDate}">${c.effectiveDate.split('-').reverse().join('.')}</time> · Son kontrol: ${c.verifiedDate.split('-').reverse().join('.')} · <a href="${c.path}">${c.name} tarifesi</a>`;
    });
  });
</script>
