---
import { formatDate } from '../data/cities';
import { site } from '../data/site';
interface Props { modified: string; published?: string; category: string; readingMinutes?: number }
const { modified, published, category, readingMinutes } = Astro.props;
---
<dl class="article-meta" aria-label="Yazı bilgileri">
  <div><dt>Yazar</dt><dd><a href={site.author.url}>{site.author.name}</a></dd></div>
  <div><dt>Son güncelleme</dt><dd><time datetime={modified}>{formatDate(modified)}</time></dd></div>
  <div><dt>Kategori</dt><dd>{category}</dd></div>
  {readingMinutes && <div><dt>Okuma süresi</dt><dd>{readingMinutes} dakika</dd></div>}
  {published && published !== modified && <div class="published-date"><dt>İlk yayın</dt><dd><time datetime={published}>{formatDate(published)}</time></dd></div>}
</dl>
