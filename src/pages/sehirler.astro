---
import ContentLayout from '../layouts/ContentLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { cities, publishedCities, formatDate, money, sourceTierLabel } from '../data/cities';
import { cityPosts } from '../data/posts';
import { canonical } from '../data/site';
const title = 'Şehirlere Göre Taksi Ücretleri 2026';
const description = 'Yayımlanmış şehir taksi yazılarını inceleyin; 81 ilin tarife doğrulama durumunu, kaynak seviyesini ve güncel hesaplayıcıları görün.';
const schema = [
  {'@context':'https://schema.org','@type':'CollectionPage',name:title,url:canonical('/sehirler/'),inLanguage:'tr-TR'},
  {'@context':'https://schema.org','@type':'ItemList',itemListElement:cityPosts.map((post,index)=>({'@type':'ListItem',position:index+1,name:post.title,url:canonical(post.path)}))},
  {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Ana Sayfa',item:canonical('/')},{'@type':'ListItem',position:2,name:'Şehirler',item:canonical('/sehirler/')}]},
];
---
<ContentLayout {title} {description} path="/sehirler/" {schema}>
  <section><h2>Şehir yazıları ne sunar?</h2><p>Her yayımlanmış şehir yazısı, o şehrin merkez tarifesini, yürürlük ve kontrol tarihini, yerel rota notlarını ve kullanılabilir hesaplayıcıyı birlikte sunar. Tarifeler yerel kararlarla belirlendiği için şehirden şehre değişir.</p><p>Güvenilir güncel kaynak bulunmayan iller için yazı veya sahte hesaplama oluşturulmaz. Kaynak doğrulandığında merkezî kayıt güncellenir ve ilgili şehir yayına alınır.</p></section>
  <section class="hub-search" aria-labelledby="city-filter-title"><h2 id="city-filter-title">Yayımlanmış şehir yazılarında ara</h2><label for="city-search">Şehir adı</label><input id="city-search" type="search" placeholder="Örnek: Ankara" autocomplete="off" aria-controls="city-list"/><p id="city-filter-status" class="filter-status" role="status" aria-live="polite">{cityPosts.length} şehir yazısı gösteriliyor.</p></section>
  <div class="article-grid" id="city-list">{cityPosts.map((post)=><div data-name={post.title.toLocaleLowerCase('tr')}><BlogCard {...post}/></div>)}</div>
  <section><h2>81 ilin tarife doğrulama durumu</h2><p>{publishedCities.length} şehir için hesaplamaya açılmış tarife vardır. Diğer illerde doğrulama tamamlanana kadar tutar gösterilmez.</p><div class="table-wrap"><table><thead><tr><th>Şehir</th><th>Açılış</th><th>Kilometre</th><th>Minimum</th><th>Son doğrulama</th><th>Kaynak durumu</th></tr></thead><tbody>{cities.map((city)=><tr><th scope="row">{city.name}</th><td>{city.status === 'published' ? money(city.opening) : '—'}</td><td>{city.status === 'published' ? money(city.perKm) : '—'}</td><td>{city.status === 'published' ? money(city.minimum) : '—'}</td><td>{city.status === 'published' ? <time datetime={city.verifiedDate}>{formatDate(city.verifiedDate)}</time> : 'Bekleniyor'}</td><td>{sourceTierLabel[city.sourceTier]}</td></tr>)}</tbody></table></div></section>
  <section><h2>Kaynak durumu ne anlama gelir?</h2><dl><dt><strong>Resmî kaynak</strong></dt><dd>Belediye, UKOME, meslek odası veya kamu kurumu yayınıdır.</dd><dt><strong>İkincil kaynak</strong></dt><dd>Birincil belge erişilebilir değilse kullanılan güvenilir yerel yayın aktarımıdır.</dd><dt><strong>Doğrulama bekliyor</strong></dt><dd>Kaynağı tamamlanmamış kayıttır; ücret veya hesaplama gösterilmez.</dd></dl><p><a href="/veri-kaynaklari-ve-hesaplama-yontemi/">Güncelleme ve kaynak yöntemini inceleyin</a>.</p></section>
  <script is:inline>
    const search = document.querySelector('#city-search');
    const cards = [...document.querySelectorAll('#city-list [data-name]')];
    const status = document.querySelector('#city-filter-status');
    search?.addEventListener('input', (event) => {
      const query = event.target.value.trim().toLocaleLowerCase('tr'); let visible = 0;
      cards.forEach((card) => { const show = card.dataset.name.includes(query); card.hidden = !show; if (show) visible += 1; });
      status.textContent = visible ? `${visible} şehir yazısı gösteriliyor.` : 'Bu adla yayımlanmış bir şehir yazısı bulunamadı.';
    });
  </script>
</ContentLayout>
