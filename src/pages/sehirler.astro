---
import ContentLayout from '../layouts/ContentLayout.astro'; import { cities, money } from '../data/cities';
---
<ContentLayout title="Şehirlere Göre Taksi Ücretleri 2026" description="Yayımlanmış şehir taksi tarifelerini karşılaştırın, son kontrol tarihlerini görün ve şehre özel hesaplayıcıya ulaşın." path="/sehirler/" eyebrow="Şehir merkezi"><label>Şehir ara<input id="city-search" type="search" placeholder="Örnek: Ankara" /></label><div class="cards" id="city-list">{cities.map(city=><a class="card" href={city.path} data-name={city.name.toLocaleLowerCase('tr')}><strong>{city.name}</strong><p>Açılış {money(city.opening)} · KM {money(city.perKm)} · minimum {money(city.minimum)}</p><span>Son kontrol {city.verifiedDate.split('-').reverse().join('.')} →</span></a>)}</div><section><h2>Tarife karşılaştırması</h2><div class="table-wrap"><table><thead><tr><th>Şehir</th><th>Açılış</th><th>KM</th><th>Minimum</th><th>Kaynak düzeyi</th></tr></thead><tbody>{cities.map(city=><tr><th scope="row"><a href={city.path}>{city.name}</a></th><td>{money(city.opening)}</td><td>{money(city.perKm)}</td><td>{money(city.minimum)}</td><td>{city.sourceTier}</td></tr>)}</tbody></table></div></section><script is:inline>document.querySelector('#city-search')?.addEventListener('input',(e)=>{const q=e.target.value.toLocaleLowerCase('tr');document.querySelectorAll('#city-list [data-name]').forEach(x=>x.hidden=!x.dataset.name.includes(q));});</script></ContentLayout>
