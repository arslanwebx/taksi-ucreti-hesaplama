---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Calculator from '../components/Calculator.astro';
import { cities, fare, formatDate, money, sourceTierLabel, type City } from '../data/cities';
import { canonical, site } from '../data/site';

export function getStaticPaths(){ return cities.filter((city) => city.status === 'published').map(city=>({params:{city:city.slug},props:{city}})); }
interface Props { city: City }
const { city } = Astro.props;
const title = `${city.name} Taksi Ücreti Hesaplama 2026 | Güncel Tarife`;
const description = `${city.name} taksi ücretini güncel açılış, kilometre ve minimum ücret tarifesiyle hesaplayın; bekleme ve yerel yolculuk notlarını inceleyin.`;
const examples = [3,5,10,20].map(km=>({km,total:fare(city,km).total}));

const copy = {
  istanbul: {
    intro: `İstanbul’da taksi maliyetini yalnızca kilometre belirlemez. Taksi türü, iki yaka arasındaki geçiş, yoğun trafikte zaman tarifesi ve seçilen ücretli yol toplamı değiştirebilir.`,
    tariffHeading: 'İstanbul taksi türleri ve güncel tarifeler',
    formulaHeading: 'Sarı taksi için örnek mesafe hesabı',
    routeHeading: 'İki yaka ve ilçeler arasında rota seçimi',
    routeIntro: 'Köprü seçimi, Avrasya Tüneli, tek yönlü yollar ve yoğunluk nedeniyle uygulamadaki rota düz çizgi mesafeden belirgin biçimde farklı olabilir.',
    travelHeading: 'Havalimanları, köprüler ve bekleme bedeli',
    travelIntro: 'İstanbul Havalimanı ve Sabiha Gökçen yolculuklarında terminal ile tam adres arasındaki yol mesafesini kullanın. Anadolu ve Avrupa yakası geçişlerinde ücretli güzergâhı yolculuk başlamadan netleştirin.'
  },
  ankara: {
    intro: `Ankara’da Kızılay, AŞTİ ve çevre ilçeler arasındaki geniş yol ağı mesafeyi hızla artırabilir. Bu sayfadaki hesap merkez tarife değerlerini kullanır; kaynak düzeyi ayrıca gösterilir.`,
    tariffHeading: 'Ankara merkez taksi tarifesi ve kaynak durumu',
    formulaHeading: 'Ankara’da kısa ve uzun mesafe hesabı',
    routeHeading: 'Kızılay’dan AŞTİ ve çevre ilçelere yolculuk',
    routeIntro: 'Çevre yolu, geniş bulvarlar ve ilçeler arası bağlantılar, mesafeyi başlangıç ile varışın tam konumuna göre değiştirebilir.',
    travelHeading: 'Esenboğa, şehir içi uzun yollar ve ek masraflar',
    travelIntro: 'Esenboğa Havalimanı yolculuğunda ilçe adı yerine terminal ile tam adres arasındaki karayolu mesafesini kullanın. Ücretli bir yol seçilecekse bedelini ayrıca ekleyin.'
  },
  izmir: {
    intro: `İzmir hesaplayıcısı 1 Nisan 2026’dan geçerli merkez taksi tarifesini kullanır. Konak, Bornova ve Karşıyaka dışındaki ilçelerde farklı bir tarife bulunabileceği için aracın içindeki güncel listeyi kontrol edin.`,
    tariffHeading: 'İzmir merkez taksileri için doğrulanmış tarife',
    formulaHeading: 'İzmir merkez tarifesiyle mesafe örnekleri',
    routeHeading: 'Körfez çevresi ve ilçe bağlantıları',
    routeIntro: 'Körfez çevresindeki güzergâhlar, sahil yolları ve tek yön düzenlemeleri Konak, Bornova ve Karşıyaka arasındaki yolculuk mesafesini etkileyebilir.',
    travelHeading: 'Adnan Menderes Havalimanı ve dış ilçe farkları',
    travelIntro: 'Adnan Menderes Havalimanı için terminal ile varış noktası arasındaki yol mesafesini esas alın. Merkez dışı ilçe tarifesini merkez hesabıyla aynı kabul etmeyin.'
  },
  antalya: {
    intro: `Antalya merkez tarifesi, havalimanı ile Lara ve Konyaaltı gibi merkez bölgeler için temel bir tahmin verir. Kundu, Belek ve diğer turizm bölgelerinde tam otel konumu ile yerel tarife kapsamı ayrıca kontrol edilmelidir.`,
    tariffHeading: 'Antalya merkez taksi tarifesi',
    formulaHeading: 'Merkez tarifesiyle mesafe örnekleri',
    routeHeading: 'Sahil ve turizm bölgelerinde mesafe',
    routeIntro: 'Havalimanı, sahil ve turizm bölgeleri arasındaki mesafe otelin veya mahallenin tam konumuna göre önemli ölçüde değişebilir.',
    travelHeading: 'Havalimanı, Kundu, Belek ve sezonluk trafik',
    travelIntro: 'Yaz sezonunda havalimanı, Lara, Kundu ve Belek yönündeki yolculuk süresi uzayabilir. Dış ilçelerde merkez tarifesinin geçerli olduğunu varsaymayın.'
  }
}[city.slug]!;

const faqs = [
  [`2026 ${city.name} taksi açılış ücreti ne kadar?`, `2026 ${city.name} standart taksi açılış ücreti ${money(city.opening)} tutarındadır. Taksimetre bu bedelle başlar; mesafe, doğrulanmış bekleme ve varsa geçiş ücretleri ayrıca hesaba katılır.`],
  [`${city.name} taksi kilometre ücreti ne kadar?`, `${city.name} standart veya merkez tarifesinde kilometre başına ${money(city.perKm)} uygulanır. Gerçek yol uzunluğu seçilen güzergâha göre değişebileceği için kuş uçuşu mesafe kullanılmamalıdır.`],
  [`${city.name} minimum taksi ücreti ne kadar?`, `${city.name} için yayımlanan minimum yolculuk ücreti ${money(city.minimum)} tutarındadır. Açılış ve mesafe hesabı bu sınırın altında kalırsa kısa yolculukta minimum ücret geçerli olur.`],
  [`${city.name} gece taksi tarifesi var mı?`, `${city.nightTariff.note} Hesaplayıcı bu nedenle doğrulanmamış bir gece katsayısı eklemez.`]
];
const schema = [
  {'@context':'https://schema.org','@type':'WebPage',name:title,description,url:canonical(city.path),inLanguage:'tr-TR'},
  {'@context':'https://schema.org','@type':'Article',headline:`${city.name} Taksi Ücreti Hesaplama 2026`,description,dateModified:city.verifiedDate,datePublished:city.effectiveDate,mainEntityOfPage:canonical(city.path),author:{'@type':'Person',name:site.author.name,url:canonical(site.author.url)},publisher:{'@type':'Organization',name:site.publisher,url:site.url}},
  {'@context':'https://schema.org','@type':'Person',name:site.author.name,url:canonical(site.author.url)},
  {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))}
];
---
<BaseLayout {title} {description} path={city.path} {schema} type="article">
  <div class="container content-shell"><Breadcrumbs items={[{name:'Ana Sayfa',href:'/'},{name:'Şehirler',href:'/sehirler/'},{name:`${city.name} taksi ücreti`,href:city.path}]}/><article>
    <header class="page-header"><p class="eyebrow">2026 tarife rehberi</p><h1>{city.name} Taksi Ücreti Hesaplama 2026</h1><p class="lead">{copy.intro}</p><p><strong>Güncel kısa cevap:</strong> Açılış {money(city.opening)}, kilometre başına {money(city.perKm)}, minimum yolculuk ücreti {money(city.minimum)}.</p><p class="notice">Kaynak düzeyi: <strong>{sourceTierLabel[city.sourceTier]}</strong> · Son kontrol: <time datetime={city.verifiedDate}>{formatDate(city.verifiedDate)}</time></p></header>

    <Calculator fixedCity={city.slug}/>

    {city.slug === 'ankara' && <section><h2>{copy.routeHeading}</h2><p>{copy.routeIntro}</p><ul>{city.routes.map(route=><li><strong>{route.name}:</strong> yaklaşık {route.km} km için beklemesiz tahmin {money(fare(city,route.km).total)}.</li>)}</ul><p>Kızılay, AŞTİ, Çankaya, Keçiören, Batıkent ve Sincan arasında başlangıç adresini tam seçmek hesap kalitesini artırır.</p></section>}

    <section><h2>{copy.tariffHeading}</h2><div class="table-wrap"><table><thead><tr><th>Kategori</th><th>Açılış</th><th>Kilometre</th><th>Minimum</th><th>Bekleme / saat</th></tr></thead><tbody>{city.categories.map(cat=><tr><th scope="row">{cat.name}</th><td>{money(cat.opening)}</td><td>{money(cat.perKm)}</td><td>{money(cat.minimum)}</td><td>{cat.waitingPerHour ? money(cat.waitingPerHour) : 'Doğrulanmadı'}</td></tr>)}</tbody></table></div>{city.slug === 'izmir' && <p>Bu tablo İzmir merkez taksileri içindir. Dış ilçelerde aynı tutarların uygulandığı varsayılmamalıdır.</p>}{city.slug === 'istanbul' && <p>Sarı, turkuaz, 8+1 sarı ve siyah taksiler farklı açılış, kilometre, zaman ve minimum ücretlerle çalışır.</p>}</section>

    {city.slug === 'istanbul' && <section><h2>{copy.routeHeading}</h2><p>{copy.routeIntro}</p><ul>{city.routes.map(route=><li><strong>{route.name}:</strong> {route.km} km üzerinden beklemesiz sarı taksi tahmini {money(fare(city,route.km).total)}.</li>)}</ul><p>İlçeler arası uzun yolculuklarda daha kısa görünen rota ücretli geçiş içerebilir; toplam maliyeti mesafe ve geçiş bedeli birlikte belirler.</p></section>}

    {city.slug === 'izmir' && <section><h2>{copy.routeHeading}</h2><p>{copy.routeIntro}</p><ul>{city.routes.map(route=><li><strong>{route.name}:</strong> yaklaşık {route.km} km için merkez tarifesiyle {money(fare(city,route.km).total)}.</li>)}</ul><p>Konak, Bornova, Karşıyaka ve Gaziemir dışındaki bir yolculukta tarife kapsamını ayrıca kontrol edin.</p></section>}

    {city.slug === 'antalya' && <section><h2>{copy.travelHeading}</h2><p>{copy.travelIntro}</p><p><a href={city.airport?.path}>Antalya Havalimanı taksi bilgileri</a> için merkez hesabını kullanırken varışın Lara, Konyaaltı, Kundu veya Belek sınırında olduğunu netleştirin.</p><ul>{city.extras.map(item=><li>{item}</li>)}</ul></section>}

    <section><h2>{copy.formulaHeading}</h2><p>Açılış ücreti ile mesafe bedeli toplanır; şehirde doğrulanmış zaman tarifesi varsa bekleme ayrıca eklenir. Sonuç minimum ücretin altındaysa alt sınıra tamamlanır.</p><div class="table-wrap"><table><thead><tr><th>Mesafe</th><th>Beklemesiz tahmin</th></tr></thead><tbody>{examples.map(x=><tr><th scope="row">{x.km} km</th><td>{money(x.total)}</td></tr>)}</tbody></table></div></section>

    {city.slug === 'antalya' && <section><h2>{copy.routeHeading}</h2><p>{copy.routeIntro}</p><ul>{city.routes.map(route=><li><strong>{route.name}:</strong> yaklaşık {route.km} km için merkez tarifesiyle {money(fare(city,route.km).total)}.</li>)}</ul><p>Belek gibi daha uzak turizm bölgelerinde yerel tarife kapsamını ve yol mesafesini araca binmeden kontrol edin.</p></section>}

    {city.slug !== 'istanbul' && city.slug !== 'ankara' && city.slug !== 'izmir' && city.slug !== 'antalya' && <section><h2>{copy.routeHeading}</h2><p>{copy.routeIntro}</p></section>}

    {city.slug !== 'antalya' && <section><h2>{copy.travelHeading}</h2><p>{copy.travelIntro}</p>{city.airport && <p><a href={city.airport.path}>{city.airport.name} taksi rehberi ve bağlantıları</a></p>}<ul>{city.extras.map(item=><li>{item}</li>)}</ul>{city.categories.some(category=>category.waitingPerHour) && <p>Bekleme alanı, yalnızca tabloda doğrulanmış saatlik tutar bulunan kategorilerde hesaplamaya açılır.</p>}</section>}

    <section class="source-box"><h2>Tarife kaynağı ve doğrulama düzeyi</h2><p><strong>{city.sourceName}</strong><br/>Yürürlük: <time datetime={city.effectiveDate}>{formatDate(city.effectiveDate)}</time> · Son doğrulama: <time datetime={city.verifiedDate}>{formatDate(city.verifiedDate)}</time></p><p>{city.sourceTier === 'official' ? 'Tarife resmî kurum kaynağıyla doğrulandı.' : 'Birincil tarife belgesine erişilemediği için güvenilir ikincil kaynak kullanıldı; bu durum hesap sonuçlarında açıkça belirtilir.'}</p><a href={city.sourceUrl} rel="external">Tarife kaynağını görüntüle</a></section>

    <section class="faq"><h2>{city.name} taksi ücreti hakkında sorular</h2>{faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section>
    <section><h2>İlgili hesaplama ve rehberler</h2><p><a href="/">Genel taksi ücreti hesaplama</a> · <a href="/sehirler/">Yayımlanmış şehir tarifeleri</a> · <a href="/taksi-rehberi/">Taksi ücretleri rehberi</a></p></section>
    <section class="author"><span class="avatar" aria-hidden="true">OA</span><div><h2>Yazar hakkında</h2><p><a href={site.author.url}>{site.author.name}</a>, tarife kaynaklarını sade hesaplara ve şehir odaklı yolculuk rehberlerine dönüştürür. Kaynak düzeyi ve belirsizlikler içerikte açıkça gösterilir.</p></div></section>
  </article></div>
</BaseLayout>
