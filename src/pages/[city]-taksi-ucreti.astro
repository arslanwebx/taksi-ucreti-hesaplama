---
import BaseLayout from '../layouts/BaseLayout.astro'; import Breadcrumbs from '../components/Breadcrumbs.astro'; import Calculator from '../components/Calculator.astro'; import { cities, fare, money, type City } from '../data/cities'; import { canonical, site } from '../data/site';
export function getStaticPaths(){ return cities.map(city=>({params:{city:city.slug},props:{city}})); }
interface Props { city: City } const { city }=Astro.props; const title=`${city.name} Taksi Ücreti Hesaplama 2026 | Güncel Tarife`; const description=`${city.name} taksi ücretini güncel açılış, kilometre ve minimum ücret tarifesiyle hesaplayın; bekleme ve yerel yolculuk notlarını inceleyin.`;
const examples=[3,5,10,20].map(km=>({km,total:fare(city,km).total})); const faqs=[[`2026 ${city.name} taksi açılış ücreti ne kadar?`,`${money(city.opening)}.`],[`${city.name} taksi kilometre ücreti ne kadar?`,`${money(city.perKm)}.`],[`${city.name} indi bindi ücreti ne kadar?`,`${money(city.minimum)} minimum yolculuk ücreti uygulanır.`],[`${city.name} gece taksi tarifesi var mı?`,city.nightRule]];
const schema=[{'@context':'https://schema.org','@type':'Article',headline:`${city.name} Taksi Ücreti Hesaplama 2026`,description,dateModified:city.verifiedDate,datePublished:city.effectiveDate,mainEntityOfPage:canonical(city.path),author:{'@type':'Person',name:site.author.name,url:canonical(site.author.url)},publisher:{'@type':'Organization',name:site.publisher,url:site.url}},{'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))}];
---
<BaseLayout {title} {description} path={city.path} {schema} type="article"><div class="container content-shell"><Breadcrumbs items={[{name:'Ana Sayfa',href:'/'},{name:'Şehirler',href:'/sehirler/'},{name:`${city.name} taksi ücreti`,href:city.path}]}/><article><header class="page-header"><p class="eyebrow">{city.verifiedDate.slice(0,4)} tarife rehberi</p><h1>{city.name} Taksi Ücreti Hesaplama 2026</h1><p class="lead">{city.name} için {money(city.opening)} açılış, kilometre başına {money(city.perKm)} ve {money(city.minimum)} minimum ücret temel alınır.</p><p class="notice">Kaynak düzeyi: <strong>{city.sourceTier}</strong>. Son kontrol: <time datetime={city.verifiedDate}>{city.verifiedDate.split('-').reverse().join('.')}</time>.</p></header><Calculator fixedCity={city.slug}/>
<section><h2>{city.name} güncel taksi tarifesi</h2><div class="table-wrap"><table><thead><tr><th>Kategori</th><th>Açılış</th><th>Kilometre</th><th>Minimum</th><th>Bekleme / saat</th></tr></thead><tbody>{city.categories.map(cat=><tr><th scope="row">{cat.name}</th><td>{money(cat.opening)}</td><td>{money(cat.perKm)}</td><td>{money(cat.minimum)}</td><td>{cat.waitingPerHour ? money(cat.waitingPerHour) : 'Yayımlanmadı'}</td></tr>)}</tbody></table></div></section>
<section><h2>Ücret nasıl hesaplanır?</h2><p>Temel tahmin açılış ücreti + (mesafe × kilometre ücreti) + doğrulanmış bekleme bedeli şeklindedir. Bu toplam minimum ücretten düşükse minimum ücret uygulanır. Ücretli yol ve geçişler sonradan eklenir.</p><div class="table-wrap"><table><thead><tr><th>Mesafe</th><th>Beklemesiz tahmin</th></tr></thead><tbody>{examples.map(x=><tr><th scope="row">{x.km} km</th><td>{money(x.total)}</td></tr>)}</tbody></table></div></section>
<section><h2>{city.name} içinde örnek güzergâhlar</h2><p>{city.districts.join(', ')} yolculuklarında gerçek mesafe başlangıç ve varış noktasına göre değişir. Aşağıdaki değerler yalnızca girilecek yaklaşık mesafeyi gösterir.</p><ul>{city.routes.map(route=><li><strong>{route.name}:</strong> yaklaşık {route.km} km için beklemesiz tahmin {money(fare(city,route.km).total)}.</li>)}</ul>{city.local.map(note=><p>{note}</p>)}</section>
<section><h2>Havalimanı, trafik ve ek ücretler</h2>{city.airport && <p><a href={city.airport.path}>{city.airport.name} taksi yolculukları</a> için haritadaki güncel mesafeyi hesaplayıcıya girin.</p>}<ul>{city.extras.map(x=><li>{x}</li>)}</ul><p>{city.nightRule}</p></section>
<section class="source-box"><h2>Tarife kaynağı</h2><p><strong>{city.sourceName}</strong><br/>Yürürlük: <time datetime={city.effectiveDate}>{city.effectiveDate.split('-').reverse().join('.')}</time> · Son doğrulama: <time datetime={city.verifiedDate}>{city.verifiedDate.split('-').reverse().join('.')}</time></p><a href={city.sourceUrl} rel="external">Kaynağı görüntüle</a></section>
<section class="faq"><h2>{city.name} taksi ücreti hakkında sorular</h2>{faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section>
<section><h2>İlgili sayfalar</h2><p><a href="/">Taksi ücreti hesaplama</a> · <a href="/sehirler/">Tüm şehir tarifeleri</a> · <a href="/taksi-rehberi/">Taksi rehberi</a></p></section>
<section class="author"><span class="avatar" aria-hidden="true">OA</span><div><h2>Yazar hakkında</h2><p><a href={site.author.url}>{site.author.name}</a>, şehir tarifelerini anlaşılır hesaplara dönüştüren içerikleri hazırlar. Tarifeler kaynaklarıyla birlikte gözden geçirilir.</p></div></section></article></div></BaseLayout>
