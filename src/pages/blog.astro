---
import ContentLayout from '../layouts/ContentLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { posts } from '../data/posts';
import { canonical } from '../data/site';
const title = 'Taksi Ücretleri Blogu';
const description = 'Şehir taksi tarifeleri ve havalimanı taksi ücretleri hakkında yayımlanmış, kaynak kontrollü hesaplama yazılarını keşfedin.';
const schema = [
  {'@context':'https://schema.org','@type':'CollectionPage',name:title,url:canonical('/blog/'),inLanguage:'tr-TR'},
  {'@context':'https://schema.org','@type':'ItemList',itemListElement:posts.map((post,index)=>({'@type':'ListItem',position:index+1,name:post.title,url:canonical(post.path)}))},
  {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Ana Sayfa',item:canonical('/')},{'@type':'ListItem',position:2,name:'Blog',item:canonical('/blog/')}]},
];
---
<ContentLayout {title} {description} path="/blog/" {schema}>
  <nav class="category-cards" aria-label="Blog kategorileri">
    <a href="/sehirler/"><strong>Şehirler</strong><span>Şehre özel tarifeler, yerel rota notları ve hesaplayıcılar.</span></a>
    <a href="/havalimani-taksi-ucretleri/"><strong>Havalimanı Taksi Ücretleri</strong><span>Terminalden şehre taksi maliyetini etkileyen mesafe ve geçişler.</span></a>
  </nav>
  <section><h2>Yayımlanmış tüm yazılar</h2><div class="article-grid">{posts.map((post)=><BlogCard {...post}/>)}</div></section>
</ContentLayout>
