---
import ContentLayout from '../layouts/ContentLayout.astro';
import { posts } from '../data/posts';
const groups = [
  ['Ana sayfalar', [['Ana Sayfa','/'],['Şehir Hesaplayıcıları','/#sehir-hesaplayicilari'],['Blog','/blog/'],['Şehirler','/sehirler/'],['Havalimanı Taksi Ücretleri','/havalimani-taksi-ucretleri/']]],
  ['Yazılar', posts.map((post) => [post.title, post.path])],
  ['Site ve güven', [['Hakkımızda','/hakkimizda/'],['İletişim','/iletisim/'],['Oğuzhan Arslan','/taksi-rehberi/'],['Veri Kaynakları ve Hesaplama Yöntemi','/veri-kaynaklari-ve-hesaplama-yontemi/'],['Editoryal Politika','/editoryal-politika/'],['Düzeltme Politikası','/duzeltme-politikasi/']]],
  ['Yasal', [['Gizlilik Politikası','/gizlilik-politikasi/'],['Çerez Politikası','/cerez-politikasi/'],['Kullanım Koşulları','/kullanim-kosullari/'],['Sorumluluk Reddi','/sorumluluk-reddi/']]],
] as const;
---
<ContentLayout title="Sitemap" description="Taksi Ücreti Hesaplama sitesindeki aktif, canonical ve ziyaret edilebilir ana sayfaları, yazıları, kategori ve politika sayfalarını görüntüleyin." path="/sitemap/">
  <div class="sitemap-grid">{groups.map(([title,links])=><section><h2>{title}</h2><ul>{links.map(([label,href])=><li><a href={href}>{label}</a></li>)}</ul></section>)}</div>
</ContentLayout>
