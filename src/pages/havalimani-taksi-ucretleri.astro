---
import ContentLayout from '../layouts/ContentLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { airportPosts } from '../data/posts';
import { canonical } from '../data/site';
const title = 'Havalimanı Taksi Ücretleri 2026';
const description = 'Yayımlanmış havalimanı taksi yazılarını inceleyin; terminal, mesafe, trafik, taksi kategorisi ve ücretli geçişlerin tahmini ücrete etkisini görün.';
const schema = [
  {'@context':'https://schema.org','@type':'CollectionPage',name:title,url:canonical('/havalimani-taksi-ucretleri/'),inLanguage:'tr-TR'},
  {'@context':'https://schema.org','@type':'ItemList',itemListElement:airportPosts.map((post,index)=>({'@type':'ListItem',position:index+1,name:post.title,url:canonical(post.path)}))},
  {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Ana Sayfa',item:canonical('/')},{'@type':'ListItem',position:2,name:title,item:canonical('/havalimani-taksi-ucretleri/')}]},
];
---
<ContentLayout {title} {description} path="/havalimani-taksi-ucretleri/" {schema}>
  <p class="notice">Yalnızca yayında olan havalimanı yazıları listelenir. Sabit fiyat olmayan rotalarda güncel karayolu mesafesini ve gerçekten kullanılacak geçişleri hesaba katın.</p>
  <div class="article-grid">{airportPosts.map((post)=><BlogCard {...post}/>)}</div>
  <section><h2>Havalimanı tahmini nasıl yapılır?</h2><ol><li>Terminal ile tam varış adresi arasındaki yol mesafesini bulun.</li><li>Şehir sayfasında geçerli taksi kategorisini seçin.</li><li>Yalnızca doğrulanmış bekleme tarifesi varsa süre ekleyin.</li><li>Gerçekten kullanılacak otoyol, köprü veya tünel bedelini ayrıca yazın.</li></ol><p>Havalimanı örnekleri sabit fiyat garantisi değildir; ödenecek tutarı taksimetre ve geçiş bedelleri belirler.</p></section>
  <p><a href="/blog/">Tüm blog yazılarını görüntüle</a></p>
</ContentLayout>
