---
import ContentLayout from '../layouts/ContentLayout.astro';
import { site } from '../data/site';
---
<ContentLayout title="İletişim" description="Tarife hatası, hesaplama sorunu veya içerik düzeltme talebinizi Taksi Ücreti Hesaplama ekibine güvenli form üzerinden iletin." path="/iletisim/" eyebrow="Bize ulaşın">
  <p>Tarife bildirimlerinde mümkünse resmî karar veya kurum bağlantısını paylaşın. Form verileri yalnızca talebinizi incelemek ve size yanıt vermek için kullanılır.</p>
  <form class="contact-form" id="contact-form" action="/api/contact" method="post">
    <label>Adınız<input name="name" autocomplete="name" required maxlength="100" /></label>
    <label>E-posta adresiniz<input name="email" type="email" autocomplete="email" required maxlength="200" /></label>
    <label>Konu<select name="subject" required><option value="">Seçin</option><option>Tarife hatası bildir</option><option>Hesaplama sorunu</option><option>İçerik düzeltme talebi</option><option>Genel iletişim</option></select></label>
    <fieldset class="tariff-report" data-tariff-fields hidden><legend>Tarife bildirimi ayrıntıları</legend>
      <label>Şehir<input name="city" maxlength="100" /></label>
      <label>Bildirilen tarife<input name="reportedTariff" maxlength="300" placeholder="Açılış, kilometre ve minimum tutar" /></label>
      <label>Yürürlük tarihi<input name="effectiveDate" type="date" /></label>
      <label>Resmî kaynak bağlantısı<input name="source" type="url" maxlength="500" placeholder="https://" /></label>
    </fieldset>
    <label>Mesajınız<textarea name="message" required minlength="10" maxlength="4000"></textarea></label>
    <label class="hp" aria-hidden="true">Web sitesi<input name="website" tabindex="-1" autocomplete="off" /></label>
    <label><input name="privacy" type="checkbox" required /> <span><a href="/gizlilik-politikasi/">Gizlilik politikasını</a> okudum ve form verilerimin talebim için işlenmesini kabul ediyorum.</span></label>
    <button class="button" type="submit">Mesajı gönder</button>
    <p class="status" role="status" aria-live="polite"></p>
  </form>
  <p>Alternatif iletişim: <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p>
  <style>.hp{position:absolute;left:-9999px}.contact-form label:has(input[type=checkbox]){grid-template-columns:auto 1fr;align-items:start}.contact-form input[type=checkbox]{width:22px;min-height:22px}.tariff-report{display:grid;gap:14px;padding:16px;border:1px solid var(--line);border-radius:12px}.tariff-report[hidden]{display:none}.tariff-report legend{padding-inline:6px;font-weight:800}</style>
  <script is:inline>
    const form = document.querySelector('#contact-form');
    const subject = form?.elements.subject;
    const tariffFields = form?.querySelector('[data-tariff-fields]');
    const tariffInputs = tariffFields ? [...tariffFields.querySelectorAll('input')] : [];
    const updateTariffFields = () => {
      const visible = subject?.value === 'Tarife hatası bildir';
      if (tariffFields) tariffFields.hidden = !visible;
      tariffInputs.forEach((input) => input.required = visible);
    };
    subject?.addEventListener('change', updateTariffFields);
    updateTariffFields();
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const status = form.querySelector('.status');
      const button = form.querySelector('button');
      if (!form.reportValidity()) return;
      button.disabled = true; status.textContent = 'Gönderiliyor…';
      try {
        const response = await fetch(form.action,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(form)))});
        const data = await response.json();
        status.textContent = data.message || 'İşlem tamamlanamadı.';
        if (response.ok) { form.reset(); updateTariffFields(); }
      } catch { status.textContent = 'Bağlantı kurulamadı. Bilgileriniz silinmedi; yeniden deneyebilir veya e-posta gönderebilirsiniz.'; }
      finally { button.disabled = false; }
    });
  </script>
</ContentLayout>
