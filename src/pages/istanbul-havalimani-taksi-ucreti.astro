---
import ContentLayout from '../layouts/ContentLayout.astro';
import Calculator from '../components/Calculator.astro';
import ArticleMeta from '../components/ArticleMeta.astro';
import AuthorBox from '../components/AuthorBox.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { publishedCities, fare, formatDate, money } from '../data/cities';
import { canonical, site } from '../data/site';
const city = publishedCities.find((item) => item.slug === 'istanbul')!;
const routes = [['Taksim',42],['Sultanahmet',47],['Beşiktaş',44],['Kadıköy',60],['Sabiha Gökçen Havalimanı',80]] as const;
const modified = city.verifiedDate;
const title = 'İstanbul Havalimanı Taksi Ücreti 2026';
const description = 'İstanbul Havalimanı taksi ücretini güncel İstanbul tarifesiyle hesaplayın; taksi kategorileri, rota, trafik ve ücretli yol etkisini inceleyin.';
const schema = [
  {'@context':'https://schema.org','@type':'WebPage',name:title,description,url:canonical('/istanbul-havalimani-taksi-ucreti/'),inLanguage:'tr-TR'},
  {'@context':'https://schema.org','@type':'BlogPosting',headline:title,description,dateModified:modified,datePublished:modified,author:{'@type':'Person',name:site.author.name,url:canonical(site.author.url)},publisher:{'@type':'Organization',name:site.publisher,url:site.url}},
  {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Ana Sayfa',item:canonical('/')},{'@type':'ListItem',position:2,name:'Havalimanı Taksi Ücretleri',item:canonical('/havalimani-taksi-ucretleri/')},{'@type':'ListItem',position:3,name:title,item:canonical('/istanbul-havalimani-taksi-ucreti/')}]},
];
---
<ContentLayout {title} {description} path="/istanbul-havalimani-taksi-ucreti/" {schema} type="article">
  <ArticleMeta slot="meta" {modified} category="Havalimanı Taksi Ücretleri" readingMinutes={5}/>
  <p class="notice">Havalimanı için sabit fiyat yoktur. Haritanızdaki güncel mesafeyi ve olası ücretli yol bedelini hesaplayıcıya girin.</p>
  <TableOfContents items={[{id:'hesaplama',label:'İstanbul Havalimanı taksi hesaplama'},{id:'rotalar',label:'Popüler varış noktaları için mesafe örnekleri'},{id:'hazirlik',label:'Taksiye binmeden önce'},{id:'kaynak',label:'Tarife dayanağı'}]}/>
  <section id="hesaplama"><h2>İstanbul Havalimanı taksi hesaplama</h2><Calculator fixedCity="istanbul"/></section>
  <section id="rotalar"><h2>Popüler varış noktaları için mesafe örnekleri</h2><div class="table-wrap"><table><thead><tr><th>Varış</th><th>Örnek mesafe</th><th>Beklemesiz sarı taksi tahmini</th></tr></thead><tbody>{routes.map(([name,km])=><tr><th scope="row">{name}</th><td>{km} km</td><td>{money(fare(city,km).total)}</td></tr>)}</tbody></table></div><p>Mesafeler yaklaşık örnektir; başlangıç kapısı, rota, trafik ve ücretli geçişler sonucu değiştirir.</p></section>
  <section id="hazirlik"><h2>Taksiye binmeden önce</h2><ol><li>Terminaldeki resmî taksi alanını kullanın.</li><li>Taksi kategorisini ve taksimetrenin açıldığını kontrol edin.</li><li>Köprü, tünel veya otoyol tercihini sürücüyle netleştirin.</li><li>Uçuş bağlantınız varsa trafik için ek süre bırakın.</li></ol><p><a href="/istanbul-taksi-ucreti/">İstanbul şehir tarifesini</a> veya <a href="/havalimani-taksi-ucretleri/">diğer havalimanı yazılarını</a> inceleyebilirsiniz.</p></section>
  <section class="source-box" id="kaynak"><h2>Tarife dayanağı</h2><p>Hesaplar <time datetime={city.effectiveDate}>{formatDate(city.effectiveDate)}</time> tarihinden geçerli İBB TUHİM taksi tarifesini kullanır. Havalimanı rota mesafeleri sabit ücret değildir.</p><a href={city.sourceUrl} rel="external">İBB tarife belgesi</a></section>
  <AuthorBox />
</ContentLayout>
