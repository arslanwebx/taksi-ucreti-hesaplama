---
import BaseLayout from '../layouts/BaseLayout.astro'; import Calculator from '../components/Calculator.astro'; import { cities, money } from '../data/cities'; import { site, canonical } from '../data/site';
const title='Taksi Ücreti Hesaplama 2026 | Şehir ve KM’ye Göre'; const description='Şehrinizi ve mesafeyi seçerek güncel taksi ücretini hesaplayın. Açılış, kilometre, indi bindi ve bekleme tarifelerini inceleyin.';
const faqs=[['Taksi ücreti nasıl hesaplanır?','Açılış, mesafe ve varsa bekleme bedeli toplanır; sonuç minimum yolculuk ücretinin altındaysa minimum ücret uygulanır.'],['Gece tarifesi var mı?','Yayımladığımız şehirlerde doğrulanmış ayrı bir gece zammı bulunmadığından hesaplayıcı gece katsayısı kullanmaz.'],['Köprü ve otoyol dahil mi?','Hayır. Tahmini geçiş bedelini ek ücret alanına kendiniz girebilirsiniz.']];
const schema=[{'@context':'https://schema.org','@type':'WebSite',name:site.name,url:site.url,inLanguage:'tr-TR'},{'@context':'https://schema.org','@type':'Organization',name:site.publisher,url:site.url},{'@context':'https://schema.org','@type':'WebApplication',name:'Taksi Ücreti Hesaplama',url:canonical('/'),applicationCategory:'FinanceApplication',operatingSystem:'Web',isAccessibleForFree:true}];
---
<BaseLayout {title} {description} path="/" {schema}>
  <header class="hero"><div class="container hero-grid"><div><p class="eyebrow">2026 şehir tarifeleri</p><h1>Taksi Ücreti Hesaplama</h1><p class="lead">Şehri, mesafeyi ve bekleme süresini girin; açılış, kilometre ve minimum ücret kurallarına göre şeffaf bir tahmin alın.</p></div><aside class="hero-note"><strong>Hızlı cevap</strong><p>Hesaplama, seçilen şehrin tek merkezî tarife kaynağını kullanır. Ücretli geçişleri ayrıca ekleyebilirsiniz.</p><a href="/veri-kaynaklari-ve-hesaplama-yontemi/">Hesaplama yöntemini inceleyin</a></aside></div></header>
  <div class="container"><Calculator /></div>
  <section class="section"><div class="container"><div class="section-heading"><p class="eyebrow">Popüler şehirler</p><h2>Şehre özel taksi hesaplama</h2><p>Her sayfa yerel tarife, bekleme kuralı ve şehir içi yolculuk notlarını birlikte sunar.</p></div><div class="cards">{cities.map(city=><a class="card" href={city.path}><strong>{city.name}</strong><p>Açılış {money(city.opening)} · kilometre {money(city.perKm)}</p><span>{city.name} taksi ücretini hesapla →</span></a>)}</div></div></section>
  <section class="section soft"><div class="container"><div class="section-heading"><h2>2026 taksi tarifesi karşılaştırması</h2><p>Rakamlar şehirlerin belirtilen merkez/standart kategorisini gösterir.</p></div><div class="table-wrap"><table><thead><tr><th>Şehir</th><th>Açılış</th><th>KM</th><th>Minimum</th><th>Yürürlük</th></tr></thead><tbody>{cities.map(city=><tr><th scope="row"><a href={city.path}>{city.name}</a></th><td>{money(city.opening)}</td><td>{money(city.perKm)}</td><td>{money(city.minimum)}</td><td><time datetime={city.effectiveDate}>{city.effectiveDate.split('-').reverse().join('.')}</time></td></tr>)}</tbody></table></div></div></section>
  <section class="section"><div class="container"><div class="section-heading"><h2>Taksi ücreti hangi kalemlerden oluşur?</h2></div><div class="cards"><div class="card"><strong>Açılış</strong><p>Taksimetre açıldığında başlayan taban bedeldir.</p></div><div class="card"><strong>Mesafe</strong><p>Gidilen kilometrenin şehir tarifesiyle çarpımıdır.</p></div><div class="card"><strong>Bekleme</strong><p>Tarifede varsa düşük hız ve bekleme için zaman bedelidir.</p></div><div class="card"><strong>Minimum ücret</strong><p>Hesaplanan tutar daha düşükse yolculuk başına alt sınırdır.</p></div></div></div></section>
  <section class="section soft"><div class="container"><div class="section-heading"><h2>Havalimanı taksi rehberleri</h2><p>Havalimanı yolculuklarında tahmini mesafenin yanında trafik ve ücretli yol seçimini de değerlendirin.</p></div><div class="cards"><a class="card" href="/istanbul-havalimani-taksi-ucreti/"><strong>İstanbul Havalimanı</strong><p>İstanbul kategorileri ve örnek güzergâhlar.</p><span>Rehberi aç →</span></a><a class="card" href="/havalimani-taksi-ucretleri/"><strong>Tüm havalimanları</strong><p>Yayımlanan havalimanı notlarını tek yerde görün.</p><span>Havalimanı rehberleri →</span></a></div></div></section>
  <section class="section"><div class="container"><div class="source-box"><h2>Veri kaynağı ve yöntem</h2><p>Resmî belediye veya UKOME belgeleri önceliklidir. Resmî belgeye erişilemeyen şehirler kaynak düzeyiyle açıkça işaretlenir; tarife, içerik ve hesaplayıcıda tek veri dosyasından okunur.</p><a href="/veri-kaynaklari-ve-hesaplama-yontemi/">Kaynak hiyerarşisi ve formül</a></div><div class="faq"><h2>Genel sorular</h2>{faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div></div></section>
</BaseLayout>
